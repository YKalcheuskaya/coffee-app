# Placeholder-only local configuration. Do not commit a real .env file.
#
# Used by `mvn spring-boot:run` after exporting these values into the shell.
DB_URL=jdbc:postgresql://localhost:5432/coffee_app
DB_USERNAME=coffee_app
DB_PASSWORD=replace-with-a-local-development-password

# Used by Docker Compose. It creates the database and passes its connection
# details to the application container.
POSTGRES_USERNAME=coffee_app
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Used by Docker Compose as the host port. For `mvn spring-boot:run`, it is
# also the application port.
APP_PORT=8080
